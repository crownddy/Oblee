# Oblee environment variables
# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API). Never commit real credentials.

# Public, safe to expose to the browser. Required for auth, data and storage.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Public origin for canonical links, Open Graph, robots.txt, sitemap.xml,
# structured data and auth email redirects.
# Local development: http://localhost:3000. Production: the real domain,
# e.g. https://oblee-liart.vercel.app
# Optional on Vercel: when unset the deployment uses its own production domain
# (VERCEL_PROJECT_PRODUCTION_URL), and a localhost value is ignored there.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
